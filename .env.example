# Copy to .env and fill in values before running locally.
# Never commit the real .env file.

# Django
SECRET_KEY=django-insecure-replace-me-with-a-real-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AWS / LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=eu-central-1

# Cognito (LocalStack provisioned pool for local dev)
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_REPLACE
COGNITO_APP_CLIENT_ID=REPLACE
# Leave blank to auto-build from pool id + region; or set to LocalStack endpoint:
# COGNITO_JWKS_URL=http://localhost:4566/eu-central-1_REPLACE/.well-known/jwks.json
COGNITO_JWKS_URL=

# Downstream service URLs (local processes or sibling Docker containers)
APPOINTMENT_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8003
SCHEDULE_SERVICE_URL=http://localhost:8004
FACILITY_STAFF_SERVICE_URL=http://localhost:8005
MEDICAL_RECORD_SERVICE_URL=http://localhost:8006
AUDIT_LOGGING_SERVICE_URL=http://localhost:8007

# Proxy timeout in seconds
PROXY_TIMEOUT=30
